# Скопируй этот файл в .env и поменяй под себя (start.bat / start.sh сделают это сами)

# demo — симулятор вместо камер; cameras — настоящие камеры (следующий этап)
COMPOSE_PROFILES=demo

# Порт дашборда: http://localhost:8090
DASHBOARD_PORT=8090
TZ=Asia/Tashkent

# Telegram: создай бота у @BotFather, добавь его в группу, chat id узнай у @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Локальная модель для AI-отчётов. qwen2.5:3b — лёгкая, работает без видеокарты.
# С видеокартой от 8 ГБ можно взять qwen2.5:7b — отчёты будут умнее.
OLLAMA_MODEL=qwen2.5:3b

# Ключ для приёма событий (необязательно). Если задан — камеры/симулятор шлют его в заголовке X-API-Key.
API_KEY=

# Симулятор: сколько дней истории сгенерировать и скорость потока (1 = реальное время)
BACKFILL_DAYS=14
SIM_SPEED=1

# Сколько дней хранить события
KEEP_DAYS=400
